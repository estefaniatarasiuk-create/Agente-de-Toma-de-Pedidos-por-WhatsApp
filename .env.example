# ---------------------------------------------------------------------------
# Fase 0 — Base de datos, cola de jobs y autenticación
# ---------------------------------------------------------------------------

# Credenciales usadas tanto por docker-compose (para levantar el contenedor de
# Postgres) como para armar la DATABASE_URL de abajo.
POSTGRES_USER=whatsapp_orders
POSTGRES_PASSWORD=whatsapp_orders
POSTGRES_DB=whatsapp_orders

# Cadena de conexión de Prisma. Con docker-compose usar host "postgres";
# corriendo la app fuera de Docker (npm run dev) usar "localhost".
DATABASE_URL=postgresql://whatsapp_orders:whatsapp_orders@localhost:5432/whatsapp_orders

# Redis para BullMQ (recordatorios y cancelación de comprobante, vencimiento
# de conversaciones, notificaciones). Con docker-compose usar host "redis".
REDIS_URL=redis://localhost:6379

# Auth.js (NextAuth) — sesiones firmadas con JWT. Generar con: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Carpeta donde se guardan los archivos subidos (fotos de catálogo,
# comprobantes). Con docker-compose ya apunta a un volumen dedicado
# (ver docker-compose.yml); corriendo fuera de Docker no hace falta setearla,
# usa ./uploads por defecto.
UPLOADS_DIR=

# ---------------------------------------------------------------------------
# Fase 1 — IA (catálogo asistido, horarios/zona en lenguaje natural,
# contradicciones, modo de prueba) y Google Maps (zona de entrega,
# geocodificación)
# ---------------------------------------------------------------------------

# Proveedor de LLM activo: "openai" o "anthropic". Se usa siempre uno solo
# por instancia (no hay fallback automático entre proveedores).
AI_PROVIDER=openai

# Completá las credenciales del proveedor elegido. El modelo se pasa
# explícito (no hay un default hardcodeado): usá el id de modelo vigente en
# la documentación del proveedor — para catálogo por foto / interpretación de
# menú necesitás un modelo con soporte de visión.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google Maps: geocoding server-side (dirección del local, direcciones de
# clientes en Fase 3) y el mapa interactivo del lado del cliente. Pueden ser
# la misma clave con restricciones distintas en Google Cloud Console (HTTP
# referrer para la de cliente, IP/servidor para la de geocoding).
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
